    "@hono/node-ws": "^1.3.0",
    "@langfuse/client": "^5.3.0",
    "@langfuse/otel": "^5.3.0",
    "@langfuse/tracing": "^5.3.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "ali-oss": "^6.23.0",
    "croner": "^10.0.1",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
