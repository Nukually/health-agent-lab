# Local-only technical demo; use synthetic data.
NODE_ENV=development
DEPLOY_ENV=local
PORT=13010
FRONTEND_PORT=5174
BACKEND_PORT=13010
HEALTH_AGENT_FEATURE_PROFILE=dev
VITE_HEALTH_AGENT_FEATURE_PROFILE=dev
DATABASE_URL=postgresql://demo:demo_local_only@127.0.0.1:15433/health_agent_lab
# Generate your own value: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-local-secret

# No shared credentials are supplied. Requests go to the provider you configure.
LLM_API_KEY=replace-with-your-own-key
LLM_MODEL=kimi-k2.5
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional models may require separate provider entitlements.
MEMORY_RECALL_ENABLED=false
MEMORY_REVIEW_ENABLED=false
MEMORY_PROFILE_REFRESH_ENABLED=false
EFFICACY_ANALYSIS_ENABLED=false
INTERVENTION_DEMAND_MERGE_ENABLED=false

# Optional integrations: blank means unavailable, never a built-in service.
MEDICAL_RAG_QUERY_URL=
DOCTOR_SERVER_BASE_URL=
DOCTOR_SERVER_TOKEN=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
LANGFUSE_ENABLED=false
JPUSH_ENABLED=false
ENABLE_TEST_ROUTES=false
ENABLE_EXPORT_ROUTES=false
ENABLE_DEBUG_ROUTES=false
# DEPLOY_ENV=local uses the demo verification code 123 after requesting it.
SMS_USE_FIXED_CODE=false
